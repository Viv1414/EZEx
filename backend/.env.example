ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://ezpt:ezpt@db:5432/ezpt
CORS_ORIGINS=http://localhost:3000
# Signs JWTs -- generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this example value or commit a real one. Production must set
# its own via the hosting platform's env vars (app refuses to start with
# ENVIRONMENT=production and this left as the code's insecure default).
SECRET_KEY=replace-with-your-own-generated-secret
